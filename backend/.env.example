# Copy to .env for local development
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=leash
# 32+ random characters (required when ENVIRONMENT=production):
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
# Use COOKIE_SECURE=true and COOKIE_SAMESITE=none when the frontend is on a different domain over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
